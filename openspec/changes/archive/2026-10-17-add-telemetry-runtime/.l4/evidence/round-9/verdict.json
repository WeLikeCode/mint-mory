  "findings": [
    {
      "severity": "major",
      "title": "Feedback FB-005 (refactor): span, add_count and record_value read _tracer and _meter once",
      "detail": "span(), add_count() and record_value() check _enabled and _tracer or _meter, then read the module global again to use it, and _instrument() reads _meter once more. A shutdown_telemetry() on another thread between the check and the use sets the global to None, and the call raises AttributeError ('NoneType' object has no attribute 'start_as_current_span' or 'create_counter'), although telemetry must never break its caller. Read each global once into a local and use only the local: span() reads _tracer once; add_count() and record_value() read _meter once and pass it to _instrument(), which takes the meter as a parameter instead of reading _meter. No lock is needed: a tracer or meter taken before the shutdown stays usable, and its provider drops what it gets after the shutdown. Behaviour is otherwise unchanged and the existing tests stay as they are.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-64545f65",
      "feedback": {
        "id": "FB-005",
        "kind": "refactor",
        "title": "span, add_count and record_value read _tracer and _meter once",
        "text": "span(), add_count() and record_value() check _enabled and _tracer or _meter, then read the module global again to use it, and _instrument() reads _meter once more. A shutdown_telemetry() on another thread between the check and the use sets the global to None, and the call raises AttributeError ('NoneType' object has no attribute 'start_as_current_span' or 'create_counter'), although telemetry must never break its caller. Read each global once into a local and use only the local: span() reads _tracer once; add_count() and record_value() read _meter once and pass it to _instrument(), which takes the meter as a parameter instead of reading _meter. No lock is needed: a tracer or meter taken before the shutdown stays usable, and its provider drops what it gets after the shutdown. Behaviour is otherwise unchanged and the existing tests stay as they are.",
        "by": "CiprianSpot, 2026-10-17T01:24:11Z",
        "places": [
          "packages/core/src/mintmory/core/telemetry.py:585-595",
          "packages/core/src/mintmory/core/telemetry.py:613-635"
        ],
        "env": null,
        "when": null,
        "then": null,
        "code": "def span(name: str, **attrs: Any) -> Iterator[Any]:\n    \"\"\"Context manager: a real span when enabled, else a cheap no-op.\"\"\"\n    if not _enabled or _tracer is None:\n        yield _NoopSpan()\n        return\n    with _tracer.start_as_current_span(name) as sp:\n        for key, value in attrs.items():\n            if value is not None:\n                sp.set_attribute(key, value)\n        yield sp\ndef _instrument(kind: str, factory_name: str, name: str) -> Any:\n    inst = _instruments.get(name)\n    if inst is None and _meter is not None:\n        inst = getattr(_meter, factory_name)(name)\n        _instruments[name] = inst\n    return inst\n\n\ndef add_count(name: str, value: int = 1, **attrs: Any) -> None:\n    if not _enabled or _meter is None:\n        return\n    counter = _instrument(\"counter\", \"create_counter\", name)\n    if counter is not None:\n        counter.add(value, {k: v for k, v in attrs.items() if v is not None})\n\n\ndef record_value(name: str, value: float, **attrs: Any) -> None:\n    if not _enabled or _meter is None:\n        return\n    hist = _instrument(\"histogram\", \"create_histogram\", name)\n    if hist is not None:\n        hist.record(value, {k: v for k, v in attrs.items() if v is not None})",
        "sha256": "d5f621b883b297c28324e2383f72837ef6b88a22f2dbc83b249249970785eec6",
        "retake": false
      }
    },
    {
      "severity": "major",
      "title": "Feedback FB-006 (behaviour): an injected exporter without the SDK says why telemetry is off",
      "detail": "init_telemetry() with span_exporter or metric_reader returns False silently when the OpenTelemetry SDK is missing. The caller asked for telemetry with its own exporter, so say why it is off, as the MINTMORY_OTEL_ENABLED=true branch already does: one WARNING on mintmory.telemetry that names the missing SDK and the extra to install.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-27a3cee6",
      "feedback": {
        "id": "FB-006",
        "kind": "behaviour",
        "title": "an injected exporter without the SDK says why telemetry is off",
        "text": "init_telemetry() with span_exporter or metric_reader returns False silently when the OpenTelemetry SDK is missing. The caller asked for telemetry with its own exporter, so say why it is off, as the MINTMORY_OTEL_ENABLED=true branch already does: one WARNING on mintmory.telemetry that names the missing SDK and the extra to install.",
        "by": "CiprianSpot, 2026-10-17T01:24:12Z",
        "places": [
          "packages/core/src/mintmory/core/telemetry.py:541-551"
        ],
        "env": null,
        "when": "init_telemetry() is called with a span_exporter or a metric_reader and the OpenTelemetry SDK is not installed (_sdk_available() returns False)",
        "then": "it returns False, installs no provider, and logs exactly one WARNING on the mintmory.telemetry logger that names the missing SDK and mintmory-core[otel]",
        "code": "    if _enabled:\n        return True\n\n    injected = span_exporter is not None or metric_reader is not None\n    if injected:\n        if not _sdk_available():\n            return False\n        traces_exporter = \"injected\" if span_exporter is not None else \"none\"\n        metrics_exporter = \"injected\" if metric_reader is not None else \"none\"\n    else:\n        traces_exporter = _resolve_exporter(settings, \"TRACES\")",
        "sha256": "e5b58bf853ed0b46fd8abc7eee984683d6c439b4f067fad7bbd703280d622214",
        "retake": false
      }
    }
