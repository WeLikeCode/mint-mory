  "findings": [
    {
      "severity": "major",
      "title": "Feedback FB-003 (behaviour): init_telemetry: one set of providers when two threads init at once",
      "detail": "The check of _enabled runs outside the lock and is not repeated inside it, so two threads that call init_telemetry at the same time both build providers: the second is installed as the module provider while the first stays the global one, spans reach only the first exporter, and shutdown_telemetry flushes the orphan, never the global provider. The spec says init and shutdown share one lock and a later init changes nothing. Repeat the _enabled check inside the lock (double-checked) so exactly one init builds.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-88eb7d41",
      "feedback": {
        "id": "FB-003",
        "kind": "behaviour",
        "title": "init_telemetry: one set of providers when two threads init at once",
        "text": "The check of _enabled runs outside the lock and is not repeated inside it, so two threads that call init_telemetry at the same time both build providers: the second is installed as the module provider while the first stays the global one, spans reach only the first exporter, and shutdown_telemetry flushes the orphan, never the global provider. The spec says init and shutdown share one lock and a later init changes nothing. Repeat the _enabled check inside the lock (double-checked) so exactly one init builds.",
        "by": "CiprianSpot, 2026-10-16T21:28:28Z",
        "places": [
          "packages/core/src/mintmory/core/telemetry.py:541-568"
        ],
        "env": null,
        "when": "two threads call init_telemetry at the same time (for example behind a threading.Barrier, each with its own span_exporter)",
        "then": "exactly one set of providers is built and installed as the global ones, the other call returns the same result without building, and shutdown_telemetry flushes and shuts down that one set",
        "code": "    if _enabled:\n        return True\n\n    injected = span_exporter is not None or metric_reader is not None\n    if injected:\n        if not _sdk_available():\n            return False\n        traces_exporter = \"injected\" if span_exporter is not None else \"none\"\n        metrics_exporter = \"injected\" if metric_reader is not None else \"none\"\n    else:\n        traces_exporter = _resolve_exporter(settings, \"TRACES\")\n        metrics_exporter = _resolve_exporter(settings, \"METRICS\")\n        if traces_exporter == \"none\" and metrics_exporter == \"none\":\n            return False\n        state = _resolve_state(settings)\n        if state == \"off\" or state == \"no collector\":\n            return False\n        if state == \"sdk missing\":\n            if settings.enabled == \"true\" or _has_endpoint_variable():\n                _LOGGER.warning(\n                    \"OpenTelemetry export requested but the SDK is missing; \"\n                    \"install 'mintmory-core[otel]'\"\n                )\n            return False\n\n    with _shutdown_lock:\n        try:\n            return _activate(",
        "sha256": "faba3698609c43f402e6518b6c26d3f0ca9a1a6c78a7e3a8ac2c8ba7c184850f",
        "retake": false
      }
    },
    {
      "severity": "major",
      "title": "Feedback FB-004 (behaviour): MINTMORY_OTEL_ENABLED keeps the boolean spellings it accepted before",
      "detail": "On staging, the setting was a pydantic bool, so 1, yes and on (any case) meant true and 0, no and off meant false. Now 1, yes and on become auto with a WARNING, which silently changes what a deployed setting does. Keep every spelling pydantic's boolean parser accepts, mapped to true or false, and keep auto as the third value.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-9b72c55d",
      "feedback": {
        "id": "FB-004",
        "kind": "behaviour",
        "title": "MINTMORY_OTEL_ENABLED keeps the boolean spellings it accepted before",
        "text": "On staging, the setting was a pydantic bool, so 1, yes and on (any case) meant true and 0, no and off meant false. Now 1, yes and on become auto with a WARNING, which silently changes what a deployed setting does. Keep every spelling pydantic's boolean parser accepts, mapped to true or false, and keep auto as the third value.",
        "by": "CiprianSpot, 2026-10-16T21:28:28Z",
        "places": [
          "packages/core/src/mintmory/core/config.py:220-231"
        ],
        "env": null,
        "when": "MINTMORY_OTEL_ENABLED is 1, yes, on, 0, no or off (any case)",
        "then": "the mode is true for 1, yes and on and false for 0, no and off, with no WARNING; auto, true and false (any case) keep their meaning; any other value still falls back to auto with a WARNING",
        "code": "    @field_validator(\"enabled\", mode=\"before\")\n    @classmethod\n    def _normalise_enabled(cls, value: object) -> object:\n        if isinstance(value, bool):\n            return \"true\" if value else \"false\"\n        if value is None:\n            return value\n        normalised = str(value).strip().lower()\n        if normalised in (\"auto\", \"true\", \"false\"):\n            return normalised\n        _OTEL_LOGGER.warning(\"MINTMORY_OTEL_ENABLED=%r is invalid; falling back to 'auto'\", value)\n        return \"auto\"",
        "sha256": "659a367b38086ce247a878af81ccea534152c2f1e74e5672c83619fc860024c2",
        "retake": false
      }
    }
