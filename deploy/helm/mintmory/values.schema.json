{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "MintMory Helm values",
  "description": "Schema with CONDITIONAL guardrails: replicaCount and accessMode constraints depend on storage.backend.",
  "type": "object",

  "if": {
    "properties": {
      "storage": {
        "type": "object",
        "properties": {
          "backend": { "const": "postgres" }
        },
        "required": ["backend"]
      }
    },
    "required": ["storage"]
  },
  "then": {
    "description": "Postgres mode: relax HA constraints, require a DSN source.",
    "properties": {
      "replicaCount": {
        "description": "Number of pods. Up to 20 in Postgres (HA) mode.",
        "maximum": 20
      }
    }
  },
  "else": {
    "description": "SQLite mode (default): hard single-writer guardrails — non-negotiable.",
    "properties": {
      "replicaCount": {
        "description": "Number of pods. MUST be 1 — SQLite is single-writer.",
        "maximum": 1
      },
      "persistence": {
        "properties": {
          "accessMode": {
            "description": "Must stay ReadWriteOnce (single writer).",
            "enum": ["ReadWriteOnce"]
          }
        }
      }
    }
  },

  "properties": {
    "replicaCount": {
      "description": "Number of pods. Constrained conditionally on storage.backend (see if/then/else above).",
      "type": "integer",
      "minimum": 1
    },
    "storage": {
      "type": "object",
      "description": "Storage backend selection and configuration.",
      "properties": {
        "backend": {
          "description": "Storage backend. 'sqlite' (default) = single-file, single-writer. 'postgres' = external PostgreSQL, stateless pods, N replicas.",
          "type": "string",
          "enum": ["sqlite", "postgres"]
        },
        "postgres": {
          "type": "object",
          "description": "PostgreSQL backend configuration. Required when storage.backend=postgres.",
          "properties": {
            "dsn": {
              "description": "libpq connection string (e.g. postgresql://user:pass@host:5432/db). Stored in a Secret. Mutually exclusive with existingSecret.",
              "type": "string"
            },
            "existingSecret": {
              "description": "Name of an existing Secret containing the DSN. When set, storage.postgres.dsn is ignored.",
              "type": "string"
            },
            "existingSecretKey": {
              "description": "Key inside existingSecret (or the chart-created Secret) that holds the DSN.",
              "type": "string"
            },
            "pool": {
              "type": "object",
              "properties": {
                "min": { "type": "integer", "minimum": 1 },
                "max": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository"],
      "additionalProperties": false
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "accessMode": {
          "description": "Access mode. In sqlite mode, constrained to ReadWriteOnce by the schema else-branch.",
          "type": "string"
        },
        "storageClassName": { "type": "string" },
        "existingClaim": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resources": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "otel": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "serviceName": { "type": "string" },
        "sampler": { "type": "string" },
        "samplerArg": { "type": "string" },
        "resourceAttributes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "pathType": { "type": "string" },
        "tls": { "type": "array" }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "description": "Ingress auth mode. Mutually exclusive.",
          "type": "string",
          "enum": ["none", "basic", "oauth2proxy"]
        },
        "basic": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "realm": { "type": "string" }
          },
          "additionalProperties": false
        },
        "oauth2proxy": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "provider": { "type": "string" },
            "oidcIssuerUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" },
            "cookieSecret": { "type": "string" },
            "emailDomains": { "type": "array" },
            "extraArgs": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "properties": {
        "liveness": { "type": "string" },
        "readiness": { "type": "string" }
      },
      "additionalProperties": false
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Automated CronJob backup is not shipped (see README). Keep false.",
          "type": "boolean",
          "enum": [false]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
