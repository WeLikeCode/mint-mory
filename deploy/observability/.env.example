# Local observability stack (copy to .env and adjust as needed).
MINTMORY_OBS_BIND=127.0.0.1
MINTMORY_OBS_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.162.0
MINTMORY_OBS_OTLP_GRPC_PORT=4317
MINTMORY_OBS_OTLP_HTTP_PORT=4318
MINTMORY_OBS_JAEGER_IMAGE=jaegertracing/jaeger:2.22.0
MINTMORY_OBS_JAEGER_UI_PORT=16686
MINTMORY_OBS_PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
MINTMORY_OBS_PROMETHEUS_PORT=9090
MINTMORY_OBS_API_PORT=8080

# MintMory-side settings (uncomment to override the defaults).
# OTEL_TRACES_SAMPLER=
# OTEL_TRACES_SAMPLER_ARG=
# OTEL_RESOURCE_ATTRIBUTES=
# OTEL_METRICS_EXPORTER=
