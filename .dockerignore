# Virtualenvs / build outputs — rebuilt inside the image by `uv sync`.
.venv
**/.venv
build
dist
*.egg-info

# VCS
.git
.gitignore

# Python caches
**/__pycache__
**/*.pyc
.mypy_cache
.ruff_cache
.pytest_cache
htmlcov
.coverage
.coverage.*

# Local SQLite stores (never bake data into the image)
*.db
*.db-wal
*.db-shm

# Secrets — never bake env/key files into the image
.env
**/.env
*.pem
*.key

# Local tooling / scratch
.firecrawl
docs/superpowers

# CI / deploy artifacts not needed at build time
.github
deploy
openspec
